{
  "name": "@trener/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "db:migrate:local": "wrangler d1 migrations apply trener-poc --local",
    "db:seed:local": "wrangler d1 execute trener-poc --local --file=./seed.sql",
    "send:test": "tsx scripts/send-test.ts",
    "eval": "tsx evals/parse-slots.eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@trener/core": "workspace:*",
    "@trener/shared": "workspace:*",
    "hono": "^4.13.10",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260928.1",
    "@types/node": "^22",
    "tsx": "^4.23.15",
    "wrangler": "^4.143.0"
  }
}
